
ENVIRONMENT=development

DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/mt_access?charset=utf8mb4

# Generate a secure random key (minimum 32 characters)
SECRET_KEY=replace-with-a-long-random-secret-key

ACCESS_TOKEN_EXPIRE_MINUTES=60

# Only executables under these roots may ever be assigned (separate with ;)
ALLOWED_APP_ROOTS=C:\Program Files\MetaTrader 5;C:\Trading

CORS_ORIGINS=http://localhost:5173

# Generate a secure random agent secret
AGENT_SECRET=replace-with-a-secure-agent-secret

# Optional: auto-create the first admin on startup if none exists
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=admin@12345

# Guacamole JSON authentication secret
GUAC_JSON_SECRET_KEY=replace-with-a-secure-guacamole-secret

# RDP credential encryption key
RDP_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-valid-fernet-key

RDP_ALLOWED_REMOTE_APP_ALIASES=MT4,MT5

GUAC_TOKEN_TTL_SECONDS=300
