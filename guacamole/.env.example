# Copy this file to ".env" in the same folder and edit the copy. NEVER commit ".env" or share its contents.
# This file contains placeholders only.

# 32 hexadecimal characters (a 128-bit key). Generate it with a secure random generator - see README.md.
# The backend will later need this SAME value to sign and encrypt Guacamole login data.
JSON_SECRET_KEY=REPLACE_WITH_32_HEX_CHARACTERS

# guacd log level: trace, debug, info, warning or error
GUACD_LOG_LEVEL=info
GUACD_LOG_LEVEL=debug
